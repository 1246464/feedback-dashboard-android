<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".EstatisticasActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNenhumaEstatistica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nenhuma estatística encontrada para a data selecionada."
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerPeriodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- 1. Gráfico de Satisfação Geral -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Satisfação Geral"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/chartSatisfacaoGeral"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp" />

        <!-- 2. Gráfico de Setores Mais Ativos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Setores Mais Ativos"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/chartSetoresAtivos"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp" />

        <!-- 3. Gráfico de Escolha por Setor -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Escolha (Prato vs. Ovo) por Setor"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.github.mikephil.charting.charts.HorizontalBarChart
            android:id="@+id/chartEscolhaSetor"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp" />

        <!-- 4. Gráfico de Satisfação por Setor -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. Nível de Satisfação por Setor"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.github.mikephil.charting.charts.HorizontalBarChart
            android:id="@+id/chartSatisfacaoSetor"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp" />

        <!-- 5. Ranking de Cardápios Mais Votados -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5. Top 10 Cardápios Mais Votados"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.github.mikephil.charting.charts.HorizontalBarChart
            android:id="@+id/chartRankingCardapios"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginBottom="16dp" />

        <!-- 6. Comparação de Períodos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6. Evolução da Satisfação"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartEvolucao"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>