<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".EstatisticasActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNenhumaEstatistica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nenhuma estatística encontrada para a data selecionada."
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerPeriodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- ===== KPIs - RESUMO SUPERIOR ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:spacing="12dp"
            android:layout_marginBottom="24dp">

            <!-- Card: Total de Avaliações -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp"
                android:backgroundTint="@android:color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:id="@+id/kpiTotalAvaliacoes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#1976D2" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avaliações"
                        android:textSize="10sp"
                        android:textColor="@android:color/darker_gray"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Satisfação Média -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp"
                android:backgroundTint="@android:color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Média"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:id="@+id/kpiMediaSatisfacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.5/4"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#388E3C" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Satisfação"
                        android:textSize="10sp"
                        android:textColor="@android:color/darker_gray"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Participação -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp"
                android:backgroundTint="@android:color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Taxa"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:id="@+id/kpiTaxaParticipacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85%"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#F57C00" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Participação"
                        android:textSize="10sp"
                        android:textColor="@android:color/darker_gray"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="20dp"
            android:alpha="0.2" />

        <!-- Card: Cardápio Mais Votado -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp"
            android:backgroundTint="@android:color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆 Cardápio Destaque"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:id="@+id/kpiCardapioDestaque"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Frango grelhado com arroz integral"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Votos: "
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />
                    <TextView
                        android:id="@+id/kpiVotosCardapio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#388E3C" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== GRÁFICOS ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Satisfação Geral"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/chartSatisfacaoGeral"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp" />

        <!-- 2. Gráfico de Setores Mais Ativos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Setores Mais Ativos"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/chartSetoresAtivos"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp" />

        <!-- 3. Gráfico de Escolha por Setor -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Escolha (Prato vs. Ovo) por Setor"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.github.mikephil.charting.charts.HorizontalBarChart
            android:id="@+id/chartEscolhaSetor"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp" />

        <!-- 4. Gráfico de Satisfação por Setor -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. Nível de Satisfação por Setor"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.github.mikephil.charting.charts.HorizontalBarChart
            android:id="@+id/chartSatisfacaoSetor"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp" />

        <!-- 5. Ranking de Cardápios Mais Votados -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5. Top 10 Cardápios Mais Votados"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.github.mikephil.charting.charts.HorizontalBarChart
            android:id="@+id/chartRankingCardapios"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginBottom="16dp" />

        <!-- 6. Comparação de Períodos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6. Evolução da Satisfação"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartEvolucao"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="24dp" />
        <!-- 7. Satisfação por Horário (MANHA/NOITE/5X2) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7. Satisfação por Horário"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/chartSatisfacaoHorario"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="24dp" />

        <!-- 8. Comparação Semanal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8. Comparação Semana Anterior vs Atual"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/chartComparacaoSemanal"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>