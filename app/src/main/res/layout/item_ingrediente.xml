<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardIngrediente"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardElevation="3dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Indicador de Status -->
        <View
            android:id="@+id/viewIndicadorIngrediente"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@android:color/holo_green_dark"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Nome do Ingrediente -->
            <TextView
                android:id="@+id/textNomeIngrediente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frango"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>

            <!-- Info Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/textQuantidadeIngrediente"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Qtd: 5kg"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"/>

                <TextView
                    android:id="@+id/textStatusIngrediente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ Disponível"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50"/>
            </LinearLayout>

            <!-- Responsável -->
            <TextView
                android:id="@+id/textResponsavelIngrediente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verificado por: João"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="4dp"
                android:visibility="gone"/>

            <!-- Data de Verificação -->
            <TextView
                android:id="@+id/textDataVerificacaoIngrediente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02/03 08:30"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="2dp"
                android:visibility="gone"/>

            <!-- Observação -->
            <TextView
                android:id="@+id/textObservacaoIngrediente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Obs: Verificar validade"
                android:textSize="12sp"
                android:textStyle="italic"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="4dp"
                android:visibility="gone"/>

            <!-- Botões de Ação -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="end">

                <Button
                    android:id="@+id/btnMarcarDisponivel"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="✓ OK"
                    android:textSize="12sp"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="6dp"
                    style="?attr/materialButtonOutlinedStyle"/>

                <Button
                    android:id="@+id/btnMarcarParcial"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="⚠ Parcial"
                    android:textSize="12sp"
                    android:backgroundTint="#FF9800"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="6dp"
                    style="?attr/materialButtonOutlinedStyle"/>

                <Button
                    android:id="@+id/btnMarcarFaltando"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="✗ Falta"
                    android:textSize="12sp"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF"
                    style="?attr/materialButtonOutlinedStyle"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
