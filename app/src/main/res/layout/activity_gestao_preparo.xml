<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Cabeçalho -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gestão de Pré-Preparo"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"/>

                    <TextView
                        android:id="@+id/textStatusGeral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Total de tarefas: 0"
                        android:textSize="14sp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Navegação de Data -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <Button
                        android:id="@+id/btnDiaAnterior"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="◀"
                        style="@style/Widget.Material3.Button.IconButton"/>

                    <TextView
                        android:id="@+id/textDataSelecionada"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="01/01/2024"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurface"/>

                    <Button
                        android:id="@+id/btnProximoDia"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="▶"
                        style="@style/Widget.Material3.Button.IconButton"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Filtros -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="8dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:padding="12dp">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupFiltros"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:checkedChip="@id/chipTodas">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTodas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Todas"
                            style="@style/Widget.Material3.Chip.Filter"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMeuTurno"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Meu Turno"
                            style="@style/Widget.Material3.Chip.Filter"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPendentes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pendentes"
                            style="@style/Widget.Material3.Chip.Filter"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipEmAndamento"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Em Andamento"
                            style="@style/Widget.Material3.Chip.Filter"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipConcluidas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Concluídas"
                            style="@style/Widget.Material3.Chip.Filter"/>

                    </com.google.android.material.chip.ChipGroup>

                </HorizontalScrollView>

            </com.google.android.material.card.MaterialCardView>

            <!-- Lista de Tarefas -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewTarefas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingBottom="80dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- Botão Flutuante Nova Tarefa -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNovaTarefa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:contentDescription="Nova tarefa"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="@android:color/white"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
