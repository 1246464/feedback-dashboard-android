<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Informações do Funcionário"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome Completo:"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/edtNomeNovoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: Maria Silva"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email (será usado para login):"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/edtEmailNovoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: maria.silva@empresa.com"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Senha (mínimo 6 caracteres):"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/edtSenhaNovoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="••••••••"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargo:"
            android:textSize="12sp"
            android:textColor="#666666" />

        <Spinner
            android:id="@+id/spinnerCargoNovoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutPlantaoNovoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Plantão (para cargos 12x36):"
                android:textSize="12sp"
                android:textColor="#666666" />

            <Spinner
                android:id="@+id/spinnerPlantaoNovoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Horário (opcional):"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/edtHorarioNovoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: 10-22 ou 5x2"
            android:inputType="text"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Setor (opcional):"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/edtSetorNovoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: Cozinha Central"
            android:inputType="text"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
