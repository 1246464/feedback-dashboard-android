<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Sugestões de Cardápio"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="#212121"
        android:paddingBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sugira pratos que gostaria de ver no cardápio!"
        android:textAlignment="center"
        android:textSize="14sp"
        android:textColor="#757575"
        android:paddingBottom="16dp"/>

    <EditText
        android:id="@+id/edtSugestao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ex: Feijoada, Lasanha, Churrasco..."
        android:inputType="text"
        android:maxLines="3"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"/>

    <Button
        android:id="@+id/btnEnviarSugestao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enviar Sugestão"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 Sugestões da Comunidade"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="12dp"/>

    <TextView
        android:id="@+id/txtSemSugestoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nenhuma sugestão ainda. Seja o primeiro!"
        android:textAlignment="center"
        android:textSize="16sp"
        android:padding="16dp"
        android:visibility="gone"/>

    <ListView
        android:id="@+id/listViewSugestoes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#CCCCCC"
        android:dividerHeight="1dp"/>

</LinearLayout>
