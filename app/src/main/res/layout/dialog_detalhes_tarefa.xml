<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textDetalhesDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descrição da tarefa aqui"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="?attr/colorOutline"/>

        <TextView
            android:id="@+id/textDetalhesTurno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Turno: MANHÃ"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/textDetalhesStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: Pendente"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/textDetalhesPrioridade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Prioridade: 3"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/textDetalhesResponsavel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Responsável: Não atribuído"
            android:textSize="14sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="?attr/colorOutline"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Observações:"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/textDetalhesObservacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sem observações"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"/>

    </LinearLayout>

</ScrollView>
