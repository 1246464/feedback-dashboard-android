<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome do Ingrediente"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/edtNomeIngrediente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ex: Frango, Arroz, Feijão..."
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quantidade"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/edtQuantidadeIngrediente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ex: 5kg, 2L, 10un..."
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Observação (opcional)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/edtObservacaoIngrediente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Alguma observação importante..."
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:minLines="2"
        android:gravity="top|start"/>
</LinearLayout>
