<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardMudanca"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardElevation="3dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="#FFF3E0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Item Alterado -->
        <TextView
            android:id="@+id/textItemAlterado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍗 Prato Principal"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"/>

        <!-- Valor Anterior -->
        <TextView
            android:id="@+id/textValorAnterior"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anterior: Frango assado"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="6dp"/>

        <!-- Valor Novo -->
        <TextView
            android:id="@+id/textValorNovo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Novo: Carne moída"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#E65100"
            android:layout_marginTop="2dp"/>

        <!-- Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/textDataMudanca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02/03/2026"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"/>

            <TextView
                android:id="@+id/textHoraMudanca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • 14:30"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/textUsuarioMudanca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Por: admin"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>

        <!-- Motivo -->
        <TextView
            android:id="@+id/textMotivoMudanca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Motivo: Falta de estoque"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="6dp"
            android:visibility="gone"/>

        <!-- Status de Notificação -->
        <TextView
            android:id="@+id/textNotificado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ Turnos notificados"
            android:textSize="11sp"
            android:textColor="#4CAF50"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
