<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTarefa"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardElevation="3dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Indicador de Prioridade -->
        <View
            android:id="@+id/viewPrioridade"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@android:color/holo_orange_dark"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Descrição -->
            <TextView
                android:id="@+id/textDescricaoTarefa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preparar ingredientes do prato principal"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>

            <!-- Info Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/textTurnoTarefa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Turno: MANHÃ"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/textPrioridadeTarefa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prioridade: 3"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- Status -->
            <TextView
                android:id="@+id/textStatusTarefa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="⏳ Pendente"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <!-- Responsável -->
            <TextView
                android:id="@+id/textResponsavelTarefa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Responsável: João Silva"
                android:textSize="13sp"
                android:visibility="gone"/>

            <!-- Timestamps -->
            <TextView
                android:id="@+id/textHoraInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Iniciada: 08:30"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/textHoraConclusao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Concluída: 09:45"
                android:textSize="12sp"
                android:textColor="@android:color/holo_green_dark"
                android:visibility="gone"/>

            <!-- Botões de Ação -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="end">

                <Button
                    android:id="@+id/btnIniciarTarefa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Iniciar"
                    android:textSize="13sp"
                    style="@style/Widget.Material3.Button.TonalButton"/>

                <Button
                    android:id="@+id/btnConcluirTarefa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Concluir ✅"
                    android:textSize="13sp"
                    style="@style/Widget.Material3.Button"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
