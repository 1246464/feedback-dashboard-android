<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="16dp"
        android:elevation="2dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 Visão Consolidada da Semana"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1976D2" />

        <!-- Cards de Resumo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/txtResumoStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 de 7 dias planejados"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:background="#E3F2FD"
                android:textColor="#1976D2" />

            <TextView
                android:id="@+id/txtResumoIngredientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 ingredientes únicos necessários"
                android:textSize="14sp"
                android:padding="8dp"
                android:layout_marginTop="8dp"
                android:background="#F1F8E9"
                android:textColor="#558B2F" />

            <TextView
                android:id="@+id/txtResumoTarefas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="~0 tarefas serão geradas"
                android:textSize="14sp"
                android:padding="8dp"
                android:layout_marginTop="8dp"
                android:background="#FFF3E0"
                android:textColor="#EF6C00" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lista de dias -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalhamento por Dia"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerDiasSemana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Botão Voltar -->
    <Button
        android:id="@+id/btnVoltarVisaoSemanal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Voltar"
        android:textSize="16sp"
        android:backgroundTint="#607D8B"
        android:layout_marginTop="8dp" />

</LinearLayout>
