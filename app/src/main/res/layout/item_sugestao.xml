<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/txtConteudoSugestao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#212121"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/txtStatusSugestao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- Botão para usuários comuns votarem -->
        <Button
            android:id="@+id/btnVotarSugestao"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="👍 Votar"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone"/>

        <!-- Botões para admin aprovar/negar -->
        <Button
            android:id="@+id/btnAprovarSugestao"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="✓ Aprovar"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnNegarSugestao"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="✗ Negar"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F44336"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone"/>
    </LinearLayout>

</LinearLayout>
