<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btnVoltarCozinha"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_alignParentStart="true"
                    android:backgroundTint="#607D8B"
                    android:text="← Voltar"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnSairCozinha"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_alignParentEnd="true"
                    android:backgroundTint="#F44336"
                    android:text="Sair"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔪 Equipe de Cozinha"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#388E3C"
                android:gravity="center"
                android:paddingTop="12dp" />

            <TextView
                android:id="@+id/txtBoasVindasCozinha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bem-vindo!"
                android:textSize="18sp"
                android:textColor="#333333"
                android:gravity="center"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/txtCargoCozinha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargo: Cozinheiro"
                android:textSize="14sp"
                android:textColor="#666666"
                android:gravity="center"
                android:paddingTop="4dp" />

            <TextView
                android:id="@+id/txtPlantaoCozinha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Plantão: A (12x36)"
                android:textSize="14sp"
                android:textColor="#666666"
                android:gravity="center"
                android:paddingTop="2dp" />
        </LinearLayout>

        <!-- Informações Rápidas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 Suas Responsabilidades"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Executar tarefas de pré-preparo"
                android:textSize="14sp"
                android:textColor="#333333"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Seguir cardápio do dia"
                android:textSize="14sp"
                android:textColor="#333333"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Registrar passagem de turno"
                android:textSize="14sp"
                android:textColor="#333333"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Consultar ingredientes disponíveis"
                android:textSize="14sp"
                android:textColor="#333333" />
        </LinearLayout>

        <!-- Ações Disponíveis -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Ações Rápidas"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/containerAcoesCozinha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
