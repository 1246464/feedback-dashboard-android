<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="visible" />

    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnVerEstatisticas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:text="Estatísticas"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSair"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:text="Sair" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="🍽️ Cardápio do Dia"
                android:textAlignment="center"
                android:textColor="#212121"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDataCardapio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="Data: --/--/----"
                android:textAlignment="center"
                android:textColor="#616161"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/cardapioContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/txtPrincipal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:paddingBottom="8dp"/>

                <TextView
                    android:id="@+id/txtGuarnicao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:paddingBottom="8dp"/>

                <TextView
                    android:id="@+id/txtAcompanhamento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:paddingBottom="8dp"/>

                <TextView
                    android:id="@+id/txtSalada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:paddingBottom="8dp"/>

                <TextView
                    android:id="@+id/txtSobremesa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"/>
            </LinearLayout>

             <TextView
                android:id="@+id/txtMensagemVoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Você já registrou sua escolha para hoje!"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:textSize="16sp"
                android:padding="8dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/labelFacaSuaEscolha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faça sua escolha para hoje:"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/radioGrupoEscolha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/radioPrincipal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prato principal"/>

                <RadioButton
                    android:id="@+id/radioOvo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ovo"/>
            </RadioGroup>

            <Button
                android:id="@+id/btnConfirmarEscolha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirmar escolha"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/labelAvaliacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="O que você achou do cardápio?"
                android:textSize="16sp"
                android:layout_marginTop="16dp"/>

            <RadioGroup
                android:id="@+id/radioGrupoAvaliacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="center">

                <RadioButton
                    android:id="@+id/radioRuim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="😞\nRuim"
                    android:textSize="14sp"
                    android:gravity="center_horizontal"
                    android:padding="4dp"/>

                <RadioButton
                    android:id="@+id/radioRegular"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="😐\nRegular"
                    android:textSize="14sp"
                    android:gravity="center_horizontal"
                    android:padding="4dp"/>

                <RadioButton
                    android:id="@+id/radioBom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="😊\nBom"
                    android:textSize="14sp"
                    android:gravity="center_horizontal"
                    android:padding="4dp"/>

                <RadioButton
                    android:id="@+id/radioOtimo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="😍\nÓtimo"
                    android:textSize="14sp"
                    android:gravity="center_horizontal"
                    android:padding="4dp"/>
            </RadioGroup>

            <EditText
                android:id="@+id/edtComentario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Escreva em poucas palavras (opcional)"
                android:maxLines="2"
                android:inputType="text"/>

            <Button
                android:id="@+id/btnEnviarAvaliacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enviar Avaliação" />

            <Button
                android:id="@+id/btnSugestoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Sugerir Prato para o Cardápio"
                android:layout_marginTop="16dp"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnReservarPrato"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🍽️ Reservar Meu Prato"
                android:layout_marginTop="8dp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"/>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>