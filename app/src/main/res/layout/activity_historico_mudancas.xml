<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF9800"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 Histórico de Mudanças"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/textPeriodoMudancas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Últimas mudanças"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Filtros de Período -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:elevation="2dp">

        <Button
            android:id="@+id/btnUltimaSemana"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Última Semana"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            style="?attr/materialButtonOutlinedStyle"/>

        <Button
            android:id="@+id/btnUltimoMes"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Último Mês"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            style="?attr/materialButtonOutlinedStyle"/>
    </LinearLayout>

    <!-- Lista de Mudanças -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMudancas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"/>

    <!-- Botão Voltar -->
    <Button
        android:id="@+id/btnVoltarMudancas"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:text="← Voltar"
        android:backgroundTint="#757575"
        android:textColor="#FFFFFF"/>
</LinearLayout>
